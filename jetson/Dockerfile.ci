# Jetson Vision System - Testing & CI/CD Pipeline

FROM nvcr.io/nvidia/l4t-runtime:r35.3.1

LABEL maintainer="Auto-Bot Team"
LABEL description="Jetson Vision System - CI/CD Testing"
LABEL version="1.0"

# Build arguments for versioning
ARG BUILD_DATE
ARG VCS_REF
ARG BUILD_VERSION=latest

# Labels for build metadata
LABEL org.label-schema.build-date=$BUILD_DATE
LABEL org.label-schema.vcs-ref=$VCS_REF
LABEL org.label-schema.version=$BUILD_VERSION

# Set working directory
WORKDIR /app/jetson

# Install system dependencies including testing tools
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    python3-pytest \
    python3-coverage \
    libzmq3-dev \
    pkg-config \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip3 install --no-cache-dir -r requirements.txt

# Install testing dependencies
RUN pip3 install --no-cache-dir \
    pytest \
    pytest-cov \
    pytest-timeout \
    pytest-mock

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p config && \
    mkdir -p /app/logs && \
    mkdir -p /app/test-results

# Entry point: configurable for different CI/CD tasks
ENTRYPOINT ["/bin/bash"]
CMD ["-c", "python3 -m pytest tests/ -v --cov=. --cov-report=html:/app/test-results/coverage --cov-report=term"]
