# ============================================
# RobotOS Environment Configuration
# ============================================
# This file contains ALL configuration variables for the entire system
# Used by: miniPC server, Raspberry Pi, and Jetson
# Copy this file to .env and configure your values
# ===== Raspberry Pi Configuration =====
# Raspberry Pi IP address
RPI_IP=192.168.1.20
# SSH username for RPi
RPI_USER=pi
# SSH password (optional, use SSH keys instead)
RPI_PASSWORD=your_password_here
# Destination directory on RPi for RobotOS code
RPI_DEST_DIR=/home/pi/auto-bot-rpi
# ===== Jetson Configuration =====
# Jetson IP address or hostname
JETSON_HOST=192.168.10.200
# SSH username for Jetson
JETSON_USER=jetson
# SSH password (optional, use SSH keys instead)
JETSON_PASSWORD=your_password_here
# ===== miniPC Server Configuration =====
# miniPC IP address (used by Jetson and RPi to connect)
SERVER_IP=192.168.1.100
# Docker Registry port (where miniPC hosts images)
SERVER_PORT=5000
# ===== Docker Image Configuration =====
# RPI image name and tag
RPI_IMAGE=auto-bot-rpi
RPI_IMAGE_TAG=latest
# Jetson image name and tag
JETSON_IMAGE=jetson-vision
JETSON_IMAGE_TAG=latest
# Server image name
SERVER_IMAGE=robotos-server
# Container names
RPI_CONTAINER_NAME=auto-bot-rpi
SERVER_CONTAINER_NAME=robotos-server
# ===== Network Ports =====
# Port for Server -> RPi commands
ZMQ_PORT=5555
# Port for RPi -> Server heartbeat
HEARTBEAT_PORT=5556
# Port for Jetson -> Server commands
SERVER_PORT=5557
# ===== Movement Timing (seconds) =====
# Forward movement step duration
DUR_FORWARD=0.5
# Backward movement step duration
DUR_BACKWARD=0.5
# Turn movement step duration (left/right)
DUR_TURN=0.3
# ===== Control Parameters =====
# Minimum interval between commands (rate limiting)
SEND_COOLDOWN=0.05
# Controller hold-to-repeat interval for D-pad
REPEAT_HOLD_INTERVAL=0.15
# ===== Calibration Configuration =====
# Jetson calibration timeout (seconds)
CALIBRATION_TIMEOUT=30.0
# Jetson calibration port
JETSON_CALIBRATION_PORT=5558
# Calibration heartbeat port
CALIBRATION_HEARTBEAT_PORT=5559
# ===== Python Environment =====
# Force Python to run in unbuffered mode (for Docker logs)
PYTHONUNBUFFERED=1
# ===== GPIO Pins (BCM numbering) =====
# Configured in states.py: PINS = [17, 27, 22]
# No need to change unless hardware wiring is different
